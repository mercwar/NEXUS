## 📄 process_alloc.asm
```

; =============================================================================
; FILE     : process_alloc.asm
; [AVIS-CMT-LOGIC]: THREAD_REGISTER_SANITIZATION
; =============================================================================

.code
SanitizeCoreRegisters PROC
    xor rax, rax              ; Purge primary execution register accumulator
    xor rbx, rbx              ; Clear base tracking pointer memory index
    xor rcx, rcx              ; Clear argument count cell loop counters
    xor rdx, rdx              ; Clear data processing context buffers
    mov r8,  04D455441h       ; Lock identity signature back into register 8
    ret
SanitizeCoreRegisters ENDP
END

